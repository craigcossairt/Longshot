{
  "manifest_version": 3,
  "name": "Longshot",
  "version": "1.3.0",
  "description": "Full-page screenshots with crop, annotation, copy, download, and PDF export.",
  "action": {
    "default_title": "Capture this page",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "commands": {
    "capture-full-page": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Capture full page"
    }
  },
  "permissions": ["activeTab", "scripting", "storage", "downloads", "tabs", "offscreen", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
